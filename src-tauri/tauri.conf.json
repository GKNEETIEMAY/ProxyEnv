{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyEnv",
  "version": "0.1.0",
  "identifier": "io.github.proxyenv.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "境启 ProxyEnv",
        "width": 880,
        "height": 720,
        "minWidth": 560,
        "minHeight": 620,
        "visible": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/app-rules/*.json"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
