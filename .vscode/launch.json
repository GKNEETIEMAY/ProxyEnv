{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ProxyEnv: Tauri Debug",
      "type": "lldb",
      "request": "launch",
      "preLaunchTask": "proxyenv: prepare debug",
      "postDebugTask": "proxyenv: stop stale debug instance",
      "program": "${workspaceFolder}/.cargo-target/debug/proxyenv.exe",
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"],
      "env": {
        "CARGO_HOME": "D:\\Rust\\cargo",
        "RUSTUP_HOME": "D:\\Rust\\rustup",
        "TEMP": "${workspaceFolder}\\.debug-tmp",
        "TMP": "${workspaceFolder}\\.debug-tmp",
        "RUST_BACKTRACE": "1"
      }
    }
  ]
}
