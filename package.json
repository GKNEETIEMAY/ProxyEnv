{
  "name": "proxyenv",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "build:remote": "node scripts/build-remote-extension.mjs",
    "test:extensions": "node scripts/build-remote-extension.mjs --check && node --test scripts/test-remote-extension.mjs scripts/test-remote-network.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:remote": "node --test scripts/test-remote-bridge.mjs scripts/test-remote-tool-installation.mjs scripts/test-remote-first-connect.mjs scripts/test-app-navigation.mjs scripts/test-notifications.mjs scripts/test-mascot-game.mjs",
    "test:report": "node --test scripts/test-diagnostic-report.mjs",
    "test:brand": "node --test scripts/test-branding.mjs",
    "test:docs": "node --test scripts/test-docs.mjs",
    "test:release": "node --test scripts/test-release-contract.mjs",
    "test:updates": "node --test scripts/test-updates.mjs",
    "test:themes": "node --test scripts/test-theme-palette.mjs",
    "test:tray": "node --test scripts/test-tray-management.mjs",
    "tauri": "tauri",
    "release:build": "tauri build --ci -- --locked",
    "check": "pnpm build && pnpm test:brand && pnpm test:docs && pnpm test:release && pnpm test:updates && pnpm test:themes && pnpm test:tray && pnpm test:report && pnpm test:remote && pnpm test:extensions && cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "toml-eslint-parser": "^1.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
